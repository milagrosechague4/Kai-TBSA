# --- Server ---
KAI_MCP_HOST=127.0.0.1
KAI_MCP_PORT=8080
KAI_MCP_PATH=/mcp

# --- Database (docker-compose maps 5433 -> 5432) ---
DATABASE_URL=postgresql://kai:kai@localhost:5433/kai_empresa

# --- Auth (OAuth 2.1 / Clerk) ---
# Fail-closed: the server REFUSES to start unless either auth is configured
# (CLERK_JWKS_URI + KAI_MCP_AUDIENCE) OR KAI_AUTH_DISABLED=true is set explicitly.
CLERK_JWKS_URI=https://your-tenant.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-tenant.clerk.accounts.dev
KAI_MCP_AUDIENCE=kai-mcp-empresa
# Claim names carrying tenant + acl info (Clerk JWT template).
KAI_CLAIM_TENANT=org_id
KAI_CLAIM_ROLE=role
KAI_CLAIM_ACL=acl_tags

# Tenant this instance serves. In prod = the company's id; the token's tenant
# claim MUST match this or the request is rejected 403. In dev it's the dev tenant.
KAI_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Local dev escape hatch (NEVER true in prod) ---
# When true, auth is bypassed and every request runs as KAI_TENANT_ID / KAI_DEV_USER_ID.
KAI_AUTH_DISABLED=false
KAI_DEV_USER_ID=00000000-0000-0000-0000-0000000000aa

# --- Embeddings (dev: OpenAI; prod: bge-large local per privacy invariant) ---
OPENAI_API_KEY=
KAI_EMBEDDING_MODEL=text-embedding-3-small
KAI_EMBEDDING_DIM=1536

# --- Observability (optional, day 2+) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
